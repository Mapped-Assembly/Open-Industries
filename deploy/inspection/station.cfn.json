{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Single CPU-only private-API Open Industries inspection station; SSH stdio access",
  "Parameters": {
    "Release": {"Type": "String", "AllowedPattern": "[0-9a-f]{40}", "Description": "Reviewed full application commit, reachable in Mapped-Assembly/Open-Industries"},
    "ImageId": {"Type": "AWS::EC2::Image::Id", "Description": "Pinned Canonical Ubuntu 24.04 amd64 server AMI in this region"},
    "KeyName": {"Type": "AWS::EC2::KeyPair::KeyName"},
    "AdminCidr": {"Type": "String", "AllowedPattern": "([0-9]{1,3}\\.){3}[0-9]{1,3}/32", "Description": "Operator public IPv4 /32; only SSH is exposed"}
  },
  "Resources": {
    "Vpc": {"Type": "AWS::EC2::VPC", "Properties": {"CidrBlock": "10.83.0.0/24", "EnableDnsSupport": true, "EnableDnsHostnames": true}},
    "Gateway": {"Type": "AWS::EC2::InternetGateway"},
    "GatewayAttachment": {"Type": "AWS::EC2::VPCGatewayAttachment", "Properties": {"VpcId": {"Ref": "Vpc"}, "InternetGatewayId": {"Ref": "Gateway"}}},
    "Subnet": {"Type": "AWS::EC2::Subnet", "Properties": {"VpcId": {"Ref": "Vpc"}, "CidrBlock": "10.83.0.0/24", "MapPublicIpOnLaunch": true}},
    "Routes": {"Type": "AWS::EC2::RouteTable", "Properties": {"VpcId": {"Ref": "Vpc"}}},
    "Route": {"Type": "AWS::EC2::Route", "DependsOn": "GatewayAttachment", "Properties": {"RouteTableId": {"Ref": "Routes"}, "DestinationCidrBlock": "0.0.0.0/0", "GatewayId": {"Ref": "Gateway"}}},
    "RouteAssociation": {"Type": "AWS::EC2::SubnetRouteTableAssociation", "Properties": {"RouteTableId": {"Ref": "Routes"}, "SubnetId": {"Ref": "Subnet"}}},
    "SecurityGroup": {"Type": "AWS::EC2::SecurityGroup", "Properties": {"GroupDescription": "Restricted operator SSH; no game/camera/vision ingress", "VpcId": {"Ref": "Vpc"}, "SecurityGroupIngress": [{"IpProtocol": "tcp", "FromPort": 22, "ToPort": 22, "CidrIp": {"Ref": "AdminCidr"}}]}},
    "Station": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": ["Route", "RouteAssociation"],
      "Properties": {
        "ImageId": {"Ref": "ImageId"}, "InstanceType": "t3.small",
        "KeyName": {"Ref": "KeyName"}, "SubnetId": {"Ref": "Subnet"}, "SecurityGroupIds": [{"Ref": "SecurityGroup"}],
        "CreditSpecification": {"CPUCredits": "standard"},
        "MetadataOptions": {"HttpTokens": "required", "HttpPutResponseHopLimit": 1},
        "BlockDeviceMappings": [{"DeviceName": "/dev/sda1", "Ebs": {"VolumeType": "gp3", "VolumeSize": 30, "Encrypted": true, "DeleteOnTermination": false}}],
        "Tags": [{"Key": "Name", "Value": "oi-inspection"}, {"Key": "ApplicationCommit", "Value": {"Ref": "Release"}}],
        "UserData": {"Fn::Base64": {"Fn::Sub": "#!/bin/bash\nset -euo pipefail\nexport DEBIAN_FRONTEND=noninteractive\napt-get update\napt-get install -y git ca-certificates curl xz-utils python3.12 python3.12-venv\ninstall -d -m 0755 /opt/oi-station\ngit clone https://github.com/Mapped-Assembly/Open-Industries.git /opt/oi-station/app\ngit -C /opt/oi-station/app checkout --detach ${Release}\nbash /opt/oi-station/app/deploy/inspection/install.sh ${Release}\n"}}
      }
    }
  },
  "Outputs": {
    "InstanceId": {"Value": {"Ref": "Station"}},
    "PublicIp": {"Value": {"Fn::GetAtt": ["Station", "PublicIp"]}},
    "Release": {"Value": {"Ref": "Release"}},
    "Region": {"Value": {"Ref": "AWS::Region"}}
  }
}
